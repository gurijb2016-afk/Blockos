diff --git a/src/3rdparty/forkfd/forkfd.c b/src/3rdparty/forkfd/forkfd.c
index b663b8a9..2d1e98bc 100644
--- a/src/3rdparty/forkfd/forkfd.c
+++ b/src/3rdparty/forkfd/forkfd.c
@@ -43,6 +43,7 @@
 #include <sys/wait.h>
 #include <assert.h>
 #include <errno.h>
+#include <fcntl.h>
 #include <pthread.h>
 #include <signal.h>
 #include <stdlib.h>
@@ -503,6 +504,22 @@ static void cleanup()
     }
 }
 
+#ifdef BOS_FORKFD_POLL
+/* BlockOS: the kernel does not deliver SIGCHLD to user handlers yet, so the
+ * reaper that sigchld_handler() runs (wait4 on each child, then the payload
+ * is written to the child's pipe) is driven from a 10 ms helper thread. */
+static void *bos_forkfd_poller(void *unused)
+{
+    struct timespec nap = { 0, 10 * 1000 * 1000 };
+    (void)unused;
+    for (;;) {
+        nanosleep(&nap, NULL);
+        sigchld_handler(SIGCHLD, NULL, NULL);
+    }
+    return NULL;
+}
+#endif
+
 static void forkfd_initialize()
 {
 #if defined(HAVE_BROKEN_WAITID)
@@ -538,6 +555,12 @@ static void forkfd_initialize()
      * signal could be delivered to another thread.
      */
     sigaction(SIGCHLD, &action, &old_sigaction);
+#ifdef BOS_FORKFD_POLL
+    {
+        pthread_t poller;
+        pthread_create(&poller, NULL, bos_forkfd_poller, NULL);
+    }
+#endif
 
 #ifndef O_NOSIGPIPE
     /* disable SIGPIPE too */
@@ -840,7 +863,21 @@ int forkfd_wait4(int ffd, struct forkfd_info *info, int options, struct rusage *
             return ret;
     }
 
+#ifdef BOS_FORKFD_POLL
+    /* BlockOS read() on an empty socket returns EAGAIN instead of blocking, so a
+     * blocking wait sleeps briefly and retries until the reaper writes the payload. */
+    for (;;) {
+        ret = read(ffd, &payload, sizeof(payload));
+        if (ret != -1 || errno != EAGAIN || (options & FFDW_NOHANG))
+            break;
+        if (fcntl(ffd, F_GETFL) & O_NONBLOCK)
+            break;      /* the caller asked for a non-blocking descriptor */
+        struct timespec ts = { 0, 1000000 };    /* 1 ms */
+        nanosleep(&ts, NULL);
+    }
+#else
     ret = read(ffd, &payload, sizeof(payload));
+#endif
     if (ret == -1)
         return ret;     /* pass errno, probably EINTR, EBADF or EWOULDBLOCK */
 
