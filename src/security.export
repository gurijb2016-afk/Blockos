# ==================================================
# BlockOS Security Export
# Version 3.0
# ==================================================

[security]

# Memory protection
memory_protection=true
user_kernel_isolation=true
stack_protection=true
heap_protection=true

# Access control
permissions=true
file_permissions=true
process_permissions=true

# Process security
process_isolation=true
process_limits=true
secure_context_switch=true

# Kernel protection
kernel_mode=true
user_mode=true
syscall_validation=true

# Debug security
debug_mode=false
kernel_trace=false
panic_protection=true

# ELF security
elf_validation=true
elf_header_check=true
elf_permission_check=true

# Filesystem security
secure_mount=true
journal_integrity=true
filesystem_check=true

# Device security
driver_validation=true
device_permissions=true

# ABI security
stable_abi=true
abi_version=1
