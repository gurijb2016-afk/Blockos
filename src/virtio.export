# ==================================================
# BlockOS VirtIO Export Configuration
# Version 3.0
# ==================================================

[virtio]

enabled=true
version=1

# ------------------------------
# PCI Transport
# ------------------------------

pci_transport=true
pci_detection=true
pci_config_access=true
pci_device_scan=true
pci_bar_mapping=true

# ------------------------------
# VirtIO Core
# ------------------------------

virtio_core=true
queue_management=true
descriptor_tables=true
available_ring=true
used_ring=true
interrupt_support=true

# ------------------------------
# VirtIO Input
# ------------------------------

input=true
keyboard=true
mouse=true
tablet=true
event_queue=true
input_interrupts=true

# ------------------------------
# VirtIO Block Device
# ------------------------------

block=true
storage=true
read_support=true
write_support=true
flush_support=true
block_cache=true
request_queue=true

# ------------------------------
# VirtIO Network
# ------------------------------

net=true
ethernet=true
packet_queue=true
rx_queue=true
tx_queue=true
checksum_support=true

# ------------------------------
# Memory
# ------------------------------

dma=true
shared_memory=true
aligned_buffers=true
zero_copy=true

# ------------------------------
# Security
# ------------------------------

driver_validation=true
device_permissions=true
queue_validation=true
buffer_check=true

# ------------------------------
# Debug
# ------------------------------

debug=false
log_devices=true
log_queue=false
trace_packets=false

# ------------------------------
# Performance
# ------------------------------

multi_queue=true
async_io=true
interrupt_mode=true
polling_fallback=true

# ------------------------------
# BlockOS Integration
# ------------------------------

vfs_integration=true
scheduler_integration=true
power_management=true
hotplug_support=false
