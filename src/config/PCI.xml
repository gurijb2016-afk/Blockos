<?xml version="1.0" encoding="UTF-8"?>

<BlockOS>

<PCIConfiguration version="3.0">


<PCIManager>

    <Enabled>true</Enabled>

    <Architecture>
        <Type>x86_64</Type>
    </Architecture>


    <Detection>

        <Enabled>true</Enabled>

        <Scan>

            <Bus>true</Bus>
            <Device>true</Device>
            <Function>true</Function>

        </Scan>


        <Methods>

            <ConfigurationSpace>true</ConfigurationSpace>
            <MMIO>true</MMIO>

        </Methods>

    </Detection>


    <Configuration>

        <Access>

            <Read>true</Read>
            <Write>true</Write>

        </Access>


        <Registers>

            <VendorID>true</VendorID>
            <DeviceID>true</DeviceID>
            <ClassCode>true</ClassCode>
            <BAR>true</BAR>
            <Interrupt>true</Interrupt>

        </Registers>

    </Configuration>


</PCIManager>



<Devices>


    <Device>

        <Name>VirtIO Block Device</Name>

        <Class>Storage</Class>

        <Driver>virtio_blk</Driver>

        <Enabled>true</Enabled>


        <Features>

            <Queue>true</Queue>
            <DMA>true</DMA>
            <Interrupt>true</Interrupt>
            <ReadWrite>true</ReadWrite>

        </Features>

    </Device>



    <Device>

        <Name>VirtIO Input Device</Name>

        <Class>Input</Class>

        <Driver>virtio_input</Driver>

        <Enabled>true</Enabled>


        <Features>

            <Keyboard>true</Keyboard>
            <Mouse>true</Mouse>

        </Features>

    </Device>



    <Device>

        <Name>VirtIO Network Device</Name>

        <Class>Network</Class>

        <Driver>virtio_net</Driver>

        <Enabled>false</Enabled>


        <Features>

            <PacketQueue>true</PacketQueue>
            <DMA>true</DMA>

        </Features>

    </Device>



    <Device>

        <Name>Graphics Adapter</Name>

        <Class>Display</Class>

        <Driver>framebuffer</Driver>

        <Enabled>true</Enabled>

    </Device>


</Devices>



<DriverMatching>


    <Enabled>true</Enabled>


    <Rules>


        <Rule>

            <Vendor>1AF4</Vendor>
            <Name>VirtIO</Name>
            <AutoLoad>true</AutoLoad>

        </Rule>


        <Rule>

            <Class>Storage</Class>
            <AutoLoad>true</AutoLoad>

        </Rule>


        <Rule>

            <Class>Input</Class>
            <AutoLoad>true</AutoLoad>

        </Rule>


    </Rules>


</DriverMatching>



<Interrupts>

    <Enabled>true</Enabled>

    <MSI>true</MSI>

    <MSIX>true</MSIX>

    <LegacyIRQ>true</LegacyIRQ>


</Interrupts>



<Security>

    <ValidateDevices>true</ValidateDevices>

    <CheckBAR>true</CheckBAR>

    <SafeAccess>true</SafeAccess>

</Security>



<Debug>

    <Logging>true</Logging>

    <DeviceList>true</DeviceList>

    <Errors>true</Errors>

</Debug>


</PCIConfiguration>

</BlockOS>
