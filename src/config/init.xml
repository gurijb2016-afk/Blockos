<?xml version="1.0" encoding="UTF-8"?>

<BlockOS>

<InitConfiguration version="3.0">

    <Startup>

        <Stage id="1">
            <Name>Memory</Name>
            <Enabled>true</Enabled>
        </Stage>

        <Stage id="2">
            <Name>Interrupts</Name>
            <Enabled>true</Enabled>
        </Stage>

        <Stage id="3">
            <Name>Drivers</Name>
            <Enabled>true</Enabled>
        </Stage>

        <Stage id="4">
            <Name>Filesystem</Name>
            <Enabled>true</Enabled>
        </Stage>

        <Stage id="5">
            <Name>Scheduler</Name>
            <Enabled>true</Enabled>
        </Stage>

        <Stage id="6">
            <Name>GUI</Name>
            <Enabled>true</Enabled>
        </Stage>

    </Startup>


    <Services>

        <Service>
            <Name>VFS</Name>
            <Start>true</Start>
        </Service>

        <Service>
            <Name>Shell</Name>
            <Start>true</Start>
        </Service>

    </Services>

</InitConfiguration>

</BlockOS>
