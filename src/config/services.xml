<?xml version="1.0" encoding="UTF-8"?>

<BlockOS>

<ServiceConfiguration version="3.0">

    <ServiceManager>

        <Enabled>true</Enabled>
        <Version>1</Version>

        <Control>
            <Start>true</Start>
            <Stop>true</Stop>
            <Restart>true</Restart>
            <Status>true</Status>
            <Monitor>true</Monitor>
        </Control>

        <StartupMode>ordered</StartupMode>

    </ServiceManager>


    <Services>


        <Service id="memory">

            <Name>Memory Manager</Name>
            <Type>kernel</Type>
            <Priority>100</Priority>
            <Required>true</Required>

            <Dependencies>
                <None>true</None>
            </Dependencies>

            <Features>
                <Paging>true</Paging>
                <Heap>true</Heap>
                <Allocator>true</Allocator>
            </Features>

        </Service>


        <Service id="interrupt">

            <Name>Interrupt Manager</Name>
            <Type>kernel</Type>
            <Priority>95</Priority>
            <Required>true</Required>

            <Dependencies>
                <Require>memory</Require>
            </Dependencies>

            <Features>
                <IDT>true</IDT>
                <IRQ>true</IRQ>
                <ExceptionHandler>true</ExceptionHandler>
            </Features>

        </Service>


        <Service id="scheduler">

            <Name>Scheduler</Name>
            <Type>kernel</Type>
            <Priority>90</Priority>
            <Required>true</Required>

            <Dependencies>
                <Require>interrupt</Require>
            </Dependencies>

            <Features>
                <ProcessScheduling>true</ProcessScheduling>
                <ThreadScheduling>true</ThreadScheduling>
                <ContextSwitch>true</ContextSwitch>
            </Features>

        </Service>


        <Service id="pci">

            <Name>PCI Device Manager</Name>
            <Type>driver</Type>
            <Priority>85</Priority>
            <Required>true</Required>

            <Dependencies>
                <Require>memory</Require>
            </Dependencies>

            <Features>
                <DeviceScan>true</DeviceScan>
                <DriverMatch>true</DriverMatch>
            </Features>

        </Service>


        <Service id="drivers">

            <Name>Driver Manager</Name>
            <Type>system</Type>
            <Priority>80</Priority>
            <Required>true</Required>

            <Dependencies>
                <Require>pci</Require>
            </Dependencies>

            <Features>
                <Load>true</Load>
                <Unload>true</Unload>
                <Verify>true</Verify>
            </Features>

        </Service>


        <Service id="virtio">

            <Name>VirtIO Manager</Name>
            <Type>driver</Type>
            <Priority>75</Priority>
            <Required>true</Required>

            <Dependencies>
                <Require>drivers</Require>
            </Dependencies>

            <Devices>
                <Block>true</Block>
                <Input>true</Input>
                <Network>true</Network>
            </Devices>

        </Service>


        <Service id="filesystem">

            <Name>Virtual File System</Name>
            <Type>system</Type>
            <Priority>70</Priority>
            <Required>true</Required>

            <Dependencies>
                <Require>virtio</Require>
            </Dependencies>

            <Features>
                <Mount>true</Mount>
                <Read>true</Read>
                <Write>true</Write>
                <Journal>true</Journal>
            </Features>

        </Service>


        <Service id="process">

            <Name>Process Manager</Name>
            <Type>kernel</Type>
            <Priority>65</Priority>
            <Required>true</Required>

            <Dependencies>
                <Require>filesystem</Require>
                <Require>scheduler</Require>
            </Dependencies>

            <Features>
                <Create>true</Create>
                <Execute>true</Execute>
                <Terminate>true</Terminate>
            </Features>

        </Service>


        <Service id="elf">

            <Name>ELF Loader</Name>
            <Type>kernel</Type>
            <Priority>60</Priority>

            <Dependencies>
                <Require>process</Require>
            </Dependencies>

            <Features>
                <ELF64>true</ELF64>
                <Validation>true</Validation>
            </Features>

        </Service>


        <Service id="input">

            <Name>Input Manager</Name>
            <Type>driver</Type>
            <Priority>55</Priority>

            <Dependencies>
                <Require>drivers</Require>
            </Dependencies>

            <Devices>
                <Keyboard>true</Keyboard>
                <Mouse>true</Mouse>
            </Devices>

        </Service>


        <Service id="framebuffer">

            <Name>Framebuffer Service</Name>
            <Type>graphics</Type>
            <Priority>50</Priority>

            <Dependencies>
                <Require>drivers</Require>
            </Dependencies>

            <Features>
                <GOP>true</GOP>
                <DoubleBuffer>true</DoubleBuffer>
            </Features>

        </Service>


        <Service id="gui">

            <Name>GUI Manager</Name>
            <Type>desktop</Type>
            <Priority>40</Priority>

            <Dependencies>
                <Require>framebuffer</Require>
                <Require>input</Require>
            </Dependencies>

            <Features>
                <Windows>true</Windows>
                <Events>true</Events>
                <Fonts>true</Fonts>
            </Features>

        </Service>


        <Service id="shell">

            <Name>BlockOS Shell</Name>
            <Type>user</Type>
            <Priority>30</Priority>

            <Dependencies>
                <Require>filesystem</Require>
                <Require>process</Require>
            </Dependencies>

            <Features>
                <Commands>true</Commands>
                <Scripts>true</Scripts>
            </Features>

        </Service>


        <Service id="logging">

            <Name>Kernel Logging</Name>
            <Type>system</Type>
            <Priority>20</Priority>

            <Features>
                <Console>true</Console>
                <FileLog>true</FileLog>
                <ErrorLog>true</ErrorLog>
            </Features>

        </Service>


    </Services>


    <Shutdown>

        <Order>
            <Service>gui</Service>
            <Service>filesystem</Service>
            <Service>drivers</Service>
            <Service>scheduler</Service>
        </Order>

    </Shutdown>


</ServiceConfiguration>

</BlockOS>
