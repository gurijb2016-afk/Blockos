<?xml version="1.0" encoding="UTF-8"?>

<BlockOS>

<FilesystemConfiguration version="3.0">

    <Identity>
        <Name>BlockOS Filesystem</Name>
        <Version>1</Version>
        <Type>VFS</Type>
    </Identity>


    <VFS>

        <Enabled>true</Enabled>

        <Manager>
            <MountSystem>true</MountSystem>
            <FileDescriptors>true</FileDescriptors>
            <PathResolver>true</PathResolver>
            <DirectoryCache>true</DirectoryCache>
        </Manager>

        <Operations>
            <Open>true</Open>
            <Close>true</Close>
            <Read>true</Read>
            <Write>true</Write>
            <Seek>true</Seek>
            <Create>true</Create>
            <Delete>true</Delete>
            <Rename>true</Rename>
        </Operations>

    </VFS>


    <Storage>

        <BlockDevice>true</BlockDevice>

        <Devices>

            <VirtIOBlock>
                <Enabled>true</Enabled>
                <Queue>true</Queue>
                <DMA>true</DMA>
                <Interrupts>true</Interrupts>
            </VirtIOBlock>

        </Devices>


        <BlockSize>
            <Default>4096</Default>
            <SectorSize>512</SectorSize>
        </BlockSize>

    </Storage>


    <Cache>

        <Enabled>true</Enabled>

        <BlockCache>true</BlockCache>
        <InodeCache>true</InodeCache>
        <DirectoryCache>true</DirectoryCache>

        <Policy>
            <WriteBack>true</WriteBack>
            <ReadAhead>true</ReadAhead>
        </Policy>

    </Cache>


    <Journal>

        <Enabled>true</Enabled>

        <Mode>ordered</Mode>

        <Features>
            <Transaction>true</Transaction>
            <Recovery>true</Recovery>
            <IntegrityCheck>true</IntegrityCheck>
        </Features>

    </Journal>


    <Permissions>

        <Enabled>true</Enabled>

        <Owner>true</Owner>
        <Group>true</Group>

        <Flags>
            <Read>true</Read>
            <Write>true</Write>
            <Execute>true</Execute>
        </Flags>

    </Permissions>


    <Metadata>

        <FileSize>true</FileSize>
        <CreationTime>true</CreationTime>
        <ModificationTime>true</ModificationTime>
        <Attributes>true</Attributes>

    </Metadata>


    <FilesystemTypes>

        <RAMFS>
            <Enabled>true</Enabled>
        </RAMFS>

        <BlockFS>
            <Enabled>true</Enabled>
            <Journaling>true</Journaling>
        </BlockFS>

    </FilesystemTypes>


    <Security>

        <PathValidation>true</PathValidation>
        <AccessControl>true</AccessControl>
        <SafeWrite>true</SafeWrite>

    </Security>


    <Recovery>

        <Enabled>true</Enabled>
        <CorruptionDetection>true</CorruptionDetection>
        <RepairMode>true</RepairMode>

    </Recovery>


    <Integration>

        <Kernel>true</Kernel>
        <Scheduler>true</Scheduler>
        <ProcessManager>true</ProcessManager>
        <Shell>true</Shell>

    </Integration>


</FilesystemConfiguration>

</BlockOS>
