<?xml version="1.0" encoding="UTF-8"?>

<BlockOS>
    <DriverManager version="1.0">

        <Driver id="virtio_core">
            <Name>VirtIO Core Driver</Name>
            <Type>bus</Type>
            <Class>virtual_device</Class>
            <Version>3.0</Version>
            <Status>enabled</Status>

            <Hardware>
                <Bus>PCI</Bus>
                <Vendor>0x1AF4</Vendor>
                <DeviceFamily>VirtIO</DeviceFamily>
                <Transport>PCI_MMIO</Transport>
            </Hardware>

            <Memory>
                <DMA>true</DMA>
                <SharedBuffers>true</SharedBuffers>
                <Alignment>4096</Alignment>
            </Memory>

            <Queue>
                <Descriptor>true</Descriptor>
                <AvailableRing>true</AvailableRing>
                <UsedRing>true</UsedRing>
                <Interrupt>true</Interrupt>
            </Queue>

            <Dependencies>
                <Require>pci</Require>
                <Require>memory_manager</Require>
                <Require>interrupt_manager</Require>
            </Dependencies>

            <Init>
                <Priority>100</Priority>
                <EarlyBoot>true</EarlyBoot>
            </Init>
        </Driver>


        <Driver id="virtio_block">

            <Name>VirtIO Block Storage</Name>
            <Type>storage</Type>
            <Version>3.0</Version>
            <Status>enabled</Status>

            <Hardware>
                <Device>BlockDevice</Device>
                <SectorSize>512</SectorSize>
            </Hardware>

            <Features>
                <Read>true</Read>
                <Write>true</Write>
                <Flush>true</Flush>
                <Cache>true</Cache>
            </Features>

            <Filesystem>
                <VFS>true</VFS>
                <Journaling>true</Journaling>
            </Filesystem>

            <Dependencies>
                <Require>virtio_core</Require>
                <Require>vfs</Require>
            </Dependencies>

            <Init>
                <Priority>80</Priority>
                <Mount>true</Mount>
            </Init>

        </Driver>


        <Driver id="virtio_input">

            <Name>VirtIO Input Driver</Name>
            <Type>input</Type>
            <Version>3.0</Version>

            <Devices>
                <Keyboard>true</Keyboard>
                <Mouse>true</Mouse>
                <Tablet>true</Tablet>
            </Devices>

            <Events>
                <Queue>true</Queue>
                <Interrupt>true</Interrupt>
                <Hotplug>false</Hotplug>
            </Events>

            <Dependencies>
                <Require>virtio_core</Require>
                <Require>event_manager</Require>
            </Dependencies>

        </Driver>


        <Driver id="framebuffer">

            <Name>UEFI Framebuffer Driver</Name>
            <Type>graphics</Type>

            <Features>
                <GOP>true</GOP>
                <DoubleBuffer>true</DoubleBuffer>
                <Acceleration>false</Acceleration>
            </Features>

            <Dependencies>
                <Require>uefi</Require>
                <Require>memory_manager</Require>
            </Dependencies>

        </Driver>


        <Driver id="ps2">

            <Name>PS/2 Controller Driver</Name>
            <Type>input</Type>

            <Devices>
                <Keyboard>true</Keyboard>
                <Mouse>true</Mouse>
            </Devices>

            <Interrupts>
                <KeyboardIRQ>1</KeyboardIRQ>
                <MouseIRQ>12</MouseIRQ>
            </Interrupts>

            <Init>
                <Priority>90</Priority>
            </Init>

        </Driver>


    </DriverManager>
</BlockOS>
